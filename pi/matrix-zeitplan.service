[Unit]
Description=Matrix-Zeitplan: Schaltsteckdose der LED-Matrix nach Zeitplan schalten
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/default/matrix-waechter
ExecStart=/usr/bin/python3 /opt/matrix/matrix_zeitplan.py
# Läuft jede Minute: ohne das stünden je Lauf "Starting/Deactivated/Finished" im Journal
# (~2600 Zeilen am Tag). Geschaltet wird mit Stufe notice, Warnungen/Fehler bleiben, ebenso
# systemds Meldung, wenn der Lauf scheitert.
SyslogLevel=notice
LogLevelMax=notice
