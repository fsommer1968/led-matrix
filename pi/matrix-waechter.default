# Einstellungen für den Matrix-Wächter (wird nach /etc/default/matrix-waechter kopiert)
# Name der Matrix, wie die Bluetooth-Suche ihn zeigt (z. B. IOTBT1A2). Leer = erste IOTBT*-Matrix.
MATRIX_NAME=
# Welches GIF in die Matrix geladen wird (64×16). Die Matrix spielt es selbst ab und behält es
# auch ohne Strom; der Wächter lädt nur neu, wenn sich GIF, Tempo oder Helligkeit ändern.
MATRIX_GIF=/opt/matrix/gifs/weihnacht_bunt_64x16.gif
# Tempo 1–75 (iPhone-App: 75) und Helligkeit 0–100 (fest, wenn MATRIX_HELL_TAG leer ist)
MATRIX_TEMPO=75
MATRIX_HELL=67
# Sekunden zwischen den Suchen; nach Fehlschlägen verdoppelt bis MATRIX_PAUSE_MAX
MATRIX_SCAN_ABSTAND=30
MATRIX_PAUSE_MAX=600
# Schaltsteckdose vor der Matrix (Befehle /aus und /ein). Leer = keine.
# Neustart (AUS_SEKUNDEN stromlos), wenn NEUSTART_NACH Uploads in Folge scheitern;
# höchstens einmal je NEUSTART_ABSTAND Sekunden.
# Beispiel: MATRIX_STECKDOSE=http://192.0.2.10 (optional, leer = keine)
MATRIX_STECKDOSE=
MATRIX_AUS_SEKUNDEN=10
MATRIX_NEUSTART_NACH=3
MATRIX_NEUSTART_ABSTAND=900
# Zeitplan (matrix-zeitplan.timer schaltet die Steckdose): morgens VON-BIS, abends ab
# ABEND_VOR Minuten vor Sonnenuntergang bis ABEND_BIS. Leer = Fenster entfällt.
# Sonnenuntergang für diesen Ort (Freiburg im Breisgau, in den Einstellungen anpassen).
MATRIX_ZEITPLAN_MORGEN=06:30-08:30
MATRIX_ZEITPLAN_ABEND_VOR=30
MATRIX_ZEITPLAN_ABEND_BIS=21:30
MATRIX_BREITE=47.995
MATRIX_LAENGE=7.849
# Helligkeit nach Tageslicht: HELL_TAG von Sonnenaufgang bis HELL_NACH_UNTERGANG min nach
# Sonnenuntergang, sonst HELL_NACHT. Jeder Wechsel ist ein neuer Upload (zweimal am Tag).
# MATRIX_HELL_TAG leer = feste Helligkeit MATRIX_HELL.
MATRIX_HELL_TAG=100
MATRIX_HELL_NACHT=67
MATRIX_HELL_NACH_UNTERGANG=30
# Wechsel der Animationen (leer = immer MATRIX_GIF). adventskalender_64x16.gif erzeugt
# matrix-adventskalender.timer jede Nacht neu (Countdown). Namen ohne Pfad liegen in
# /opt/matrix/gifs. Gewechselt wird zu jeder Uhrzeit in MATRIX_GIF_WECHSEL (vor dem Einschalten
# am Nachmittag); ab MATRIX_GIFS_START läuft das erste, nach dem letzten wieder von vorn.
# Jeder Wechsel ist ein Upload (~70 KB) – auch mehrere am Tag sind fürs Flash unbedenklich.
# Weihnachten (23.11.2026): Animationen mit Grüßen ("FROHE WEIHNACHTEN", "FROHES FEST")
# erst ab 25.12. – bis dahin laufen sie nicht.
# Silvester (23.11.2026): ab 27.12. Neujahrs-Animationen im Wechsel, am 31.12. um
# 23:59:18 (sekundengenau, ~46 s aus dem Vorrat) Upload "ALLES GUTE FÜR 2027"; an Silvester an bis 01:00, ab
# 01.01.2027 01:00 aus und nie wieder an (Zeitplan schaltet nicht mehr ein, Wächter ruht).
# Wechsellisten, erzeugt mit led/pi/plan_erzeugen.py (nicht von Hand ändern): alle 30 Minuten
# ein Platz je Halbstunde ab Phasenbeginn; Namen ohne _64x16.gif. Phasen: 1 vor Advent,
# 2–5 Adventswochen, 6 Weihnachten, 7 Silvester, 8 Neujahrsgruß.
MATRIX_GIF_WECHSEL="00:00 00:30 01:00 01:30 02:00 02:30 03:00 03:30 04:00 04:30 05:00 05:30 06:00 06:30 07:00 07:30 08:00 08:30 09:00 09:30 10:00 10:30 11:00 11:30 12:00 12:30 13:00 13:30 14:00 14:30 15:00 15:30 16:00 16:30 17:00 17:30 18:00 18:30 19:00 19:30 20:00 20:30 21:00 21:30 22:00 22:30 23:00 23:30"
